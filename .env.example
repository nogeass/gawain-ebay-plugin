GAWAIN_API_BASE=https://gawain.nogeass.com
# GAWAIN_API_KEY=your_api_key_here
# GAWAIN_APP_ID=your_app_id_here
KINOSUKE_UPGRADE_URL=https://kinosuke.example.com/upgrade
# GAWAIN_POLL_INTERVAL_MS=2000
# GAWAIN_POLL_MAX_ATTEMPTS=60

# eBay OAuth credentials
# Set EBAY_ENV to "sandbox" for testing, "production" for live
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:3457/oauth/ebay/callback
# EBAY_RU_NAME=              # eBay Developer Portal "RuName" (if different from redirect URI)
# EBAY_SCOPES=               # Space-separated scopes (defaults: sell.inventory sell.marketing sell.account)
EBAY_TOKEN_FILE=.ebay_tokens.json

# eBay Trading API (Sandbox seller setup)
# Falls back to EBAY_CLIENT_ID / EBAY_CLIENT_SECRET / EBAY_DEV_ID if not set
# EBAY_TRADING_APP_ID=
# EBAY_TRADING_DEV_ID=
# EBAY_TRADING_CERT_ID=
# EBAY_TRADING_AUTH_TOKEN=   # Auth'n'Auth token (optional if OAuth token exists)
EBAY_DEV_ID=
EBAY_SITE_ID=0

# Sell Account verification (optional — reads from .ebay_tokens.json by default)
# EBAY_OAUTH_USER_TOKEN=
